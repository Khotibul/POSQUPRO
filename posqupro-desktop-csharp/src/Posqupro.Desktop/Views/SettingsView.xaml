<UserControl x:Class="Posqupro.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Akun &amp; Lisensi" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Toko" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TenantName}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="Plan" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlanName}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Text="Lisensi" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseCode}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Text="Status" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TenantStatus}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="4" Text="Pengguna" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AccountName}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="5" Text="Role" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RoleName}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Toko &amp; Struk" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                        <TextBlock Text="Nama Toko" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                        <TextBlock Text="Telepon" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                        <TextBlock Text="Alamat" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" AcceptsReturn="True" Height="60" />
                        <TextBlock Text="Header Struk" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                        <TextBlock Text="Footer Struk" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,14" />
                        <Button Content="Simpan Toko &amp; Struk" Command="{Binding SaveStoreCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Printer" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                        <TextBlock Text="Nama Printer" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Lebar Kertas" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PaperWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ukuran Font" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Font" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Spasi Baris (%)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SpacingLine, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Cetak otomatis setelah bayar" IsChecked="{Binding AutoPrint}"
                                  Style="{StaticResource Switch}" Margin="0,12,0,0" />
                        <Button Content="Simpan Printer" Command="{Binding SavePrinterCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" />
                        <Button Content="Kelola Pajak" Command="{Binding OpenTaxesCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Metode Pembayaran" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding PaymentMethods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsActive}" Style="{StaticResource Switch}" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
