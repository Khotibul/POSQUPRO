<UserControl x:Class="Posqupro.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Akun &amp; Lisensi" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Toko" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TenantName}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="Plan" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlanName}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Text="Lisensi" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseCode}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Text="Status" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TenantStatus}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="4" Text="Pengguna" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AccountName}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="5" Text="Role" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RoleName}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Toko &amp; Struk" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Nama Toko" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                            <TextBlock Text="Telepon" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Alamat" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" AcceptsReturn="True" Height="58" />
                            <TextBlock Text="Header Struk" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Footer Struk" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                            <Button Content="Simpan Toko &amp; Struk" Command="{Binding SaveStoreCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Printer" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Tipe Koneksi" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding PrinterType}"
                                      Style="{StaticResource Input}" Margin="0,0,0,10" />
                            <TextBlock Text="MAC Bluetooth" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding BluetoothMac, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                                     IsEnabled="{Binding IsBluetooth}" Margin="0,0,0,10" ToolTip="Contoh: 00:11:22:33:44:55" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Printer" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PrinterOptions}" SelectedItem="{Binding SelectedPrinter}"
                                      Style="{StaticResource Input}" Margin="0,0,0,4" />
                            <Button Content="Deteksi Printer" Command="{Binding DetectPrintersCommand}"
                                    Style="{StaticResource GhostButton}" Margin="0,0,0,10" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Lebar Kertas (kolom)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PaperWidthOptions}" SelectedItem="{Binding PaperWidth}"
                                      Style="{StaticResource Input}" Margin="0,0,0,10" ToolTip="32–72 kolom karakter (58mm ≈ 32, 80mm ≈ 42)" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Ukuran Font" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding FontSizeOptions}" SelectedItem="{Binding FontSize}"
                                      Style="{StaticResource Input}" Margin="0,0,0,10" ToolTip="Auto = 8pt" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Font" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding FontFamilyOptions}" SelectedItem="{Binding FontFamily}"
                                      Style="{StaticResource Input}" Margin="0,0,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Spasi Baris (%)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SpacingLine, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10"
                                     ToolTip="50–200" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="Margin Atas / Bawah / Kiri" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding MarginTop, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                                <TextBox Grid.Column="2" Text="{Binding MarginBottom, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                                <TextBox Grid.Column="4" Text="{Binding MarginLeft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Text="Perataan" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AlignmentOptions}" SelectedItem="{Binding Alignment}"
                                      Style="{StaticResource Input}" Margin="0,0,0,10" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Logo Struk (opsional)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ReceiptLogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                                <Button Grid.Column="2" Content="Hapus" Command="{Binding ClearLogoCommand}" Style="{StaticResource GhostButton}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Printer Laci Kas" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DrawerPrinter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,10" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <CheckBox Content="Cetak otomatis setelah bayar" IsChecked="{Binding AutoPrint}" Style="{StaticResource Switch}" Margin="0,0,0,6" />
                            <CheckBox Content="Aktifkan laci kas (drawer)" IsChecked="{Binding DrawerEnabled}" Style="{StaticResource Switch}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Simpan Printer" Command="{Binding SavePrinterCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Tes Cetak" Command="{Binding TestPrintCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                                <Button Content="Kelola Pajak" Command="{Binding OpenTaxesCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Metode Pembayaran" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding PaymentMethods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsActive}" Style="{StaticResource Switch}" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
