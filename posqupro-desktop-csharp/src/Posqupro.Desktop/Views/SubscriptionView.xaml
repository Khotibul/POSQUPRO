<UserControl x:Class="Posqupro.Desktop.Views.SubscriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Langganan &amp; Pembayaran" Style="{StaticResource SectionTitle}" FontSize="18" />
                    <TextBlock Text="Kelola paket, pantau limit, dan bayar melalui iPaymu."
                               Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <CheckBox Content="Tagihan tahunan" IsChecked="{Binding IsYearly, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Muat Ulang" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" Height="34" Margin="0,0,8,0" />
                    <Button Content="Buka Halaman Billing" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenBillingCommand}" Height="34" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding PlanName}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BlueWash}" CornerRadius="999"
                            Padding="14,7" VerticalAlignment="Top">
                        <TextBlock Text="{Binding DaysRemaining, StringFormat={}{0} hari}" FontWeight="SemiBold"
                                   Foreground="{StaticResource SignalBlue}" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Pemakaian Paket" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Limits}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Cloud}" CornerRadius="8" Padding="12,8" Margin="0,0,8,8"
                                        MinWidth="180">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Pilih Paket" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding Plans}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding LimitsLabel}" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding FeatureSummary}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding MonthlyPriceLabel}" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding YearlyPriceLabel}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Right" />
                                    <Button Content="Bayar dengan iPaymu" Style="{StaticResource PrimaryButton}"
                                            Height="34" Margin="0,8,0,0"
                                            Command="{Binding DataContext.CheckoutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Invoice Terakhir" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,16,0,8" />
            <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" MinHeight="120" MaxHeight="260">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="180" />
                    <DataGridTextColumn Header="Paket" Binding="{Binding PlanName}" Width="140" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalLabel}" Width="130" />
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding IssuedAt, StringFormat=dd/MM/yyyy}" Width="110" />
                    <DataGridTemplateColumn Header="Aksi" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Buka Pembayaran" Style="{StaticResource LinkButton}"
                                        Command="{Binding DataContext.OpenPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanPay, Converter={StaticResource BoolToVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
