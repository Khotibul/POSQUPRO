<UserControl x:Class="Posqupro.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource SectionTitle}" FontSize="18" />
                <TextBlock Text="{Binding TodayLabel}" Style="{StaticResource Muted}" Margin="12,4,0,0" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pendapatan Hari Ini" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding TodayRevenue, StringFormat=Rp {0:N0}}" Style="{StaticResource StatValue}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Transaksi Hari Ini" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding TodayTransactions}" Style="{StaticResource StatValue}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pendapatan Bulan Ini" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding MonthRevenue, StringFormat=Rp {0:N0}}" Style="{StaticResource StatValue}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Stok Menipis" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource StatValue}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                <Button Content="Buka POS" Command="{Binding OpenPosCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                <Button Content="Kelola Produk" Command="{Binding OpenProductsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0" />
                <Button Content="Lihat Laporan" Command="{Binding OpenReportsCommand}" Style="{StaticResource GhostButton}" />
                <Button Content="Muat Ulang" Command="{Binding RefreshCommand}" Style="{StaticResource LinkButton}" Margin="14,8,0,0" />
            </StackPanel>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Transaksi Terbaru" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding RecentTransactions}" Height="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="130" />
                                <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="110" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Rp {0:N0}}" Width="110" />
                                <DataGridTextColumn Header="Metode" Binding="{Binding PaymentMethod}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Stok Menipis" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding LowStockProducts}" Height="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produk" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Stok" Binding="{Binding Stock, StringFormat=N0}" Width="70" />
                                <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat=N0}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
