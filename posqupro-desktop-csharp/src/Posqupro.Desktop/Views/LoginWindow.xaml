<Window x:Class="Posqupro.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POSQUPRO Desktop" Height="640" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Cloud}"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource InkNavy}">
            <Grid Margin="42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="14" Padding="10">
                        <Image Source="/Assets/logo.png" Height="42" Width="42" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="14,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="POSQUPRO" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="SIMPLE · SMART · SUCCESS" Foreground="{StaticResource MistGray}" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Kasir, stok, dan laporan&#x0a;dalam satu aplikasi desktop."
                               Foreground="White" FontSize="30" FontWeight="Bold" LineHeight="38" />
                    <TextBlock Text="Bekerja penuh saat koneksi putus, lalu menyinkronkan transaksi ke server POSQUPRO secara otomatis saat online kembali."
                               Foreground="{StaticResource MistGray}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,18,0,0" LineHeight="21" />

                    <StackPanel Margin="0,34,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#1B4A74">
                                <TextBlock Text="✓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Transaksi offline tetap tersimpan" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#1B4A74">
                                <TextBlock Text="✓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Sinkronisasi dua arah dengan website" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#1B4A74">
                                <TextBlock Text="✓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Struk, kas shift, dan stok opname" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="© 2026 POSQUPRO" Foreground="{StaticResource MistGray}" FontSize="11" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="64,0">
            <StackPanel VerticalAlignment="Center" MaxWidth="380" HorizontalAlignment="Left">
                <TextBlock Text="Masuk ke akun Anda" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Gunakan kredensial POSQUPRO yang sama dengan website."
                           Style="{StaticResource Muted}" Margin="0,6,0,26" />

                <TextBlock Text="Alamat server" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                <TextBlock Text="Produksi: https://posqupro.co-id.id · Lokal: http://127.0.0.1:8000" Style="{StaticResource Caption}" Margin="0,6,0,14" />

                <TextBlock Text="Email" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />

                <TextBlock Text="Password" Style="{StaticResource CardTitle}" Margin="0,14,0,6" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" />

                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource SlateGray}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,14,0,0" />

                <Button Content="Masuk Online" Style="{StaticResource PrimaryButton}" Height="40"
                        Command="{Binding LoginCommand}" Margin="0,18,0,0" IsDefault="True" />

                <Button Content="Masuk Mode Offline" Style="{StaticResource GhostButton}" Height="38"
                        Command="{Binding OfflineLoginCommand}" Margin="0,10,0,0" />

                <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap"
                           Text="Mode offline hanya dapat dipakai setelah akun ini pernah login saat online di perangkat ini." />

                <Border Style="{StaticResource Divider}" Margin="0,22,0,10" />
                <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Caption}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
