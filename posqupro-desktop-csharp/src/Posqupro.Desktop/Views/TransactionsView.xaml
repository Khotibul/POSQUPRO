<UserControl x:Class="Posqupro.Desktop.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}" />
                        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                                  Width="140" Margin="10,0,0,0" />
                        <DatePicker SelectedDate="{Binding From}" Width="130" Margin="10,0,0,0" />
                        <DatePicker SelectedDate="{Binding To}" Width="130" Margin="6,0,0,0" />
                        <Button Content="Terapkan" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cetak" Command="{Binding PrintCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                        <Button Content="Hapus" Command="{Binding VoidCommand}" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Transactions}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="130" />
                        <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="110" />
                        <DataGridTextColumn Header="Pelanggan" Binding="{Binding CustomerName}" Width="140" />
                        <DataGridTextColumn Header="Kasir" Binding="{Binding CashierName}" Width="120" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Rp {0:N0}}" Width="110" />
                        <DataGridTextColumn Header="Metode" Binding="{Binding PaymentMethod}" Width="90" />
                        <DataGridTextColumn Header="Tipe" Binding="{Binding Type}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{Binding DetailInvoice}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Tutup" Command="{Binding CloseDetailCommand}"
                            Style="{StaticResource LinkButton}" HorizontalAlignment="Right" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding DetailDate}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DetailCustomer}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding DetailCashier}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <Border Style="{StaticResource Divider}" />
                    <Grid><TextBlock Text="Subtotal" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DetailSubtotal, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" /></Grid>
                    <Grid><TextBlock Text="Diskon" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DetailDiscount, StringFormat=-Rp {0:N0}}" HorizontalAlignment="Right" /></Grid>
                    <Grid><TextBlock Text="Pajak" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DetailTax, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" /></Grid>
                    <Grid><TextBlock Text="Total" FontWeight="Bold" /><TextBlock Text="{Binding DetailTotal, StringFormat=Rp {0:N0}}" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                    <Grid><TextBlock Text="Bayar" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DetailPaid, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" /></Grid>
                    <Grid><TextBlock Text="Kembali" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DetailChange, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" /></Grid>
                    <Grid><TextBlock Text="Metode" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DetailMethod}" HorizontalAlignment="Right" /></Grid>
                    <Border Style="{StaticResource Divider}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding DetailItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" />
                        <DataGridTextColumn Header="Harga" Binding="{Binding UnitPrice, StringFormat=N0}" Width="80" />
                        <DataGridTextColumn Header="Sub" Binding="{Binding Subtotal, StringFormat=N0}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
