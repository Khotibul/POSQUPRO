<UserControl x:Class="Posqupro.Desktop.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Register / Mesin Kasir" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Muat Ulang" Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Right" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Orientation="Horizontal">
                    <Button Content="Buka Sesi" Command="{Binding OpenRegisterCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="Tutup Sesi" Command="{Binding CloseRegisterCommand}" Style="{StaticResource DangerButton}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Registers}" SelectedItem="{Binding SelectedRegister}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Kode" Binding="{Binding Code}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding IsActive}" Width="80" />
                        <DataGridTextColumn Header="Sesi" Binding="{Binding SessionsCount}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Sesi Aktif" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SessionStatusLabel}" TextWrapping="Wrap" />
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <TextBlock Text="Register" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding SelectedRegister}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Riwayat Sesi" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dibuka" Binding="{Binding OpenedAt, StringFormat=dd/MM HH:mm}" Width="110" />
                            <DataGridTextColumn Header="Modal" Binding="{Binding OpeningFloat, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                            <DataGridTextColumn Header="Tertutup" Binding="{Binding ClosedAt, StringFormat=dd/MM HH:mm}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
