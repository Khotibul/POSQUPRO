<UserControl x:Class="Posqupro.Desktop.Views.ParkedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Transaksi Tertunda" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Muat Ulang" Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Right" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="130" />
                        <DataGridTextColumn Header="Pelanggan" Binding="{Binding CustomerName}" Width="140" />
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemCount}" Width="60" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Rp {0:N0}}" Width="110" />
                        <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Detail Item" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="Pulihkan ke Keranjang" Command="{Binding RestoreCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                    <Button Content="Hapus" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding SelectedItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" />
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N0}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
