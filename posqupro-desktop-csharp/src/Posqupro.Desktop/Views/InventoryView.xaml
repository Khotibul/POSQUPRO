<UserControl x:Class="Posqupro.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Total Produk" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding TotalProducts}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Nilai Stok (Beli)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding StockValue, StringFormat=Rp {0:N0}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Stok Menipis" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Button Grid.Column="6" Content="Muat Ulang" Command="{Binding RefreshCommand}"
                    Style="{StaticResource GhostButton}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Daftar Produk" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produk" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                            <DataGridTextColumn Header="Stok" Binding="{Binding Stock, StringFormat=N0}" Width="70" />
                            <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat=N0}" Width="70" />
                            <DataGridTextColumn Header="Harga" Binding="{Binding EffectivePrice, StringFormat=Rp {0:N0}}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Penyesuaian Stok" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ComboBox ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                                 Margin="0,0,0,8" ToolTip="Jumlah" />
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                                 Margin="0,0,0,10" ToolTip="Alasan" />
                        <Button Content="Terapkan" Command="{Binding AdjustCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Riwayat Pergerakan" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="100" />
                                <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Tipe" Binding="{Binding Type}" Width="70" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
