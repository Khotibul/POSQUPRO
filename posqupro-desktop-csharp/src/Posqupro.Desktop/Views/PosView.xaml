<UserControl x:Class="Posqupro.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Posqupro.Desktop.Views">
    <UserControl.Resources>
        <local:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Product grid -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Produk" Style="{StaticResource CardTitle}" DockPanel.Dock="Top" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}"
                                 ToolTip="Cari nama / SKU (Enter = tambah jika cocok) · Ctrl+F"
                                 KeyDown="OnSearchKeyDown" />
                        <Button Grid.Column="2" Content="Cari" Command="{Binding SearchEnterCommand}"
                                Style="{StaticResource GhostButton}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BarcodeBox" Grid.Column="0"
                                 Text="{Binding BarcodeText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input}"
                                 ToolTip="Scan barcode lalu Enter · Ctrl+B"
                                 KeyDown="OnBarcodeKeyDown" />
                        <Button Grid.Column="2" Content="Tambah" Command="{Binding AddByCodeCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                    </Grid>
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name" Width="180" Margin="0,8,0,0" HorizontalAlignment="Right" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding BarcodeFeedback}" Style="{StaticResource Caption}" Margin="0,8,0,0" />

                <ListBox ItemsSource="{Binding Products}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="168" Margin="0,0,10,10" Padding="12" CornerRadius="10"
                                    Background="{StaticResource Pebble}" Cursor="Hand"
                                    ToolTip="Klik untuk tambah ke keranjang"
                                    MouseLeftButtonUp="OnProductClick">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36" />
                                    <TextBlock Text="{Binding Sku}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding StockLabel}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding EffectivePrice, StringFormat=Rp {0:N0}}"
                                               Foreground="{StaticResource SignalBlue}" FontWeight="Bold" Margin="0,8,0,0" />
                                    <Button Content="Tambah" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource LinkButton}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Cart -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <TextBlock Text="Keranjang" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CartSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Pelanggan" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="Metode Bayar" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                              DisplayMemberPath="Label" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding DiscountTypeIndex}">
                            <ComboBoxItem Content="Rp" />
                            <ComboBoxItem Content="%" />
                        </ComboBox>
                    </Grid>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                             Style="{StaticResource Input}" ToolTip="Catatan" />
                </StackPanel>

                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Keranjang masih kosong — pilih produk di kiri"
                                   Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding HasCart, Converter={StaticResource InverseBoolVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,6" CornerRadius="8" Background="{StaticResource Pebble}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtotal, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" FontSize="12" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Button Content="-" Width="26" Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBox Width="44" Margin="4,0,0,0" Padding="4,3"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                             TextAlignment="Center" ToolTip="Qty" />
                                                    <Button Content="+" Width="26" Margin="4,0,0,0" Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="Rp" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="3" Width="90" Margin="4,0,0,0" Padding="4,3"
                                                         Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         TextAlignment="Right" ToolTip="Harga satuan" />
                                                <Button Grid.Column="6" Content="✕" Width="26" Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                            <TextBlock Text="{Binding StockLabel}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock Text="Subtotal" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Subtotal, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Diskon" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding DiscountValue, StringFormat=-Rp {0:N0}}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Pajak" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding TaxAmount, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <TextBlock Text="Total" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="{Binding GrandTotal, StringFormat=Rp {0:N0}}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Kembali" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Change, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" Foreground="{StaticResource Success}" />
                    </Grid>

                    <TextBlock Text="Bayar" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                    <TextBox x:Name="PaidBox" Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}" FontSize="16" FontWeight="SemiBold"
                             ToolTip="Jumlah uang diterima · Spasi = uang pas · F2 = bayar" />

                    <ItemsControl ItemsSource="{Binding QuickCashOptions}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6" Padding="8,5"
                                        Content="{Binding Label}"
                                        Command="{Binding DataContext.QuickCashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Amount}"
                                        Style="{StaticResource GhostButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Content="Cetak struk otomatis" IsChecked="{Binding AutoPrint}" Style="{StaticResource Switch}" Margin="0,4,0,0" />
                    <StackPanel Margin="0,10,0,0">
                        <Button Content="Bayar (F2)" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryButton}" Height="44" FontSize="14" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Tahan (Ctrl+S)" Command="{Binding ParkCommand}" Style="{StaticResource GhostButton}" />
                            <Button Grid.Column="2" Content="Kosongkan" Command="{Binding ClearCartCommand}" Style="{StaticResource DangerButton}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
