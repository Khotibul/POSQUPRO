<UserControl x:Class="Posqupro.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker SelectedDate="{Binding From}" Width="140" />
                    <DatePicker SelectedDate="{Binding To}" Width="140" Margin="8,0,0,0" />
                    <Button Content="7 Hari" Command="{Binding Preset7Command}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" />
                    <Button Content="30 Hari" Command="{Binding Preset30Command}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" />
                    <Button Content="90 Hari" Command="{Binding Preset90Command}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" />
                    <Button Content="Terapkan" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Pendapatan" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding Revenue, StringFormat=Rp {0:N0}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Transaksi" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding Transactions}" Style="{StaticResource StatValue}" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Rata-rata" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding Average, StringFormat=Rp {0:N0}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Arus Kas Bersih" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding NetCashflow, StringFormat=Rp {0:N0}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" /></StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Penjualan Harian" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Daily}" Height="170">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="0" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,0" VerticalAlignment="Bottom">
                                        <Border Height="{Binding Height}" Width="28" Background="{StaticResource SignalBlue}" CornerRadius="4,4,0,0" ToolTip="{Binding Tooltip}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Produk Terlaris" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding TopProducts}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produk" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                                <DataGridTextColumn Header="Omzet" Binding="{Binding Revenue, StringFormat=N0}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Metode Pembayaran" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding Payments}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Metode" Binding="{Binding Method}" Width="*" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Rp {0:N0}}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Stok Menipis" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding LowStock}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produk" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Stok" Binding="{Binding Stock}" Width="70" />
                                <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ringkasan Inventori" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Grid><TextBlock Text="Total Produk" Style="{StaticResource Muted}" /><TextBlock Text="{Binding TotalProducts}" HorizontalAlignment="Right" /></Grid>
                        <Grid><TextBlock Text="Nilai Beli" Style="{StaticResource Muted}" /><TextBlock Text="{Binding StockCostValue, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" /></Grid>
                        <Grid><TextBlock Text="Nilai Jual" Style="{StaticResource Muted}" /><TextBlock Text="{Binding StockSellValue, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" /></Grid>
                        <Grid><TextBlock Text="Stok Menipis" Style="{StaticResource Muted}" /><TextBlock Text="{Binding LowStockCount}" HorizontalAlignment="Right" /></Grid>
                        <Grid><TextBlock Text="Pengeluaran" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Expenses, StringFormat=Rp {0:N0}}" HorizontalAlignment="Right" /></Grid>
                        <Grid><TextBlock Text="Item Terjual" Style="{StaticResource Muted}" /><TextBlock Text="{Binding ItemsSold}" HorizontalAlignment="Right" /></Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
