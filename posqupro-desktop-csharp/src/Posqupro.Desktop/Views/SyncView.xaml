<UserControl x:Class="Posqupro.Desktop.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Status" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding IsOnline, StringFormat={}{0}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Antrean" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Pending}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gagal" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Failed}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sinkron Terakhir" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding LastSync}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Koneksi Server" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />
                        <Button Grid.Column="2" Content="Simpan" Command="{Binding SaveConnectionCommand}" Style="{StaticResource PrimaryButton}" />
                    </Grid>
                    <TextBlock Text="Produksi: https://posqupro.co-id.id · Lokal: http://127.0.0.1:8000" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <CheckBox Content="Sinkronisasi otomatis" IsChecked="{Binding AutoSync}" Style="{StaticResource Switch}" Margin="0,12,0,0" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Device ID" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding DeviceId}" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                    </Grid>
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Button Content="Sinkron Sekarang" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="Muat Ulang" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Antrean Sinkronisasi" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Coba Lagi" Command="{Binding RetryCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                            <Button Content="Buang" Command="{Binding DiscardCommand}" Style="{StaticResource DangerButton}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Queue}" SelectedItem="{Binding Selected}" MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Entitas" Binding="{Binding Entity}" Width="130" />
                            <DataGridTextColumn Header="Operasi" Binding="{Binding Operation}" Width="90" />
                            <DataGridTextColumn Header="Percobaan" Binding="{Binding Attempts}" Width="70" />
                            <DataGridTextColumn Header="Error" Binding="{Binding LastError}" Width="*" />
                            <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
